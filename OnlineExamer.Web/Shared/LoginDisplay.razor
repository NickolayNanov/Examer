@inject Areas.Identity.Pages.Account.LogoutModel model

<AuthorizeView>
    <Authorized>

        <div class="col-xs-6 col-md-8"></div>
        <div class="col-xs-12 col-md-4">
            <div class="d-lg-inline-flex">
                <div class="mt-3 mr-3">
                    <p style="color: white;">Hello, @context.User.Identity.Name!</p>
                </div>
                <a class="btn btn-primary" style="margin-bottom: 15px; margin-top: 10px" href="Authentication/Logout">Изход</a>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="col-xs-12 col-md-10"></div>
        <div class="col-xs-6 col-md-2">
            <a class="mr-4" href="Authentication/Register" style="color: white;">Регистрация</a>
            <a class="pull-right" href="Authentication/Login" style="color: white;">Вход</a>
        </div>
    </NotAuthorized>
</AuthorizeView>
