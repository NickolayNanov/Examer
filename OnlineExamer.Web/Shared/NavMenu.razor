<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand ml-2" href=""><img src="/logo.png" style="height: 40px;"/></a>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Начало
            </NavLink>
        </li>

        @*<li class="nav-item px-3">
            <NavLink class="nav-link" href="/StudyMaterials" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Учебни материали
            </NavLink>
        </li>*@

        <AuthorizeView Roles="Admin">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="Admin">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> Админ панел
                </NavLink>
            </li>
        </AuthorizeView>

        <AuthorizeView Roles="User">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="SolvedExams">
                        <span class="oi oi-box" aria-hidden="true"></span> Решавани изпити
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="AllExams">
                        <span class="oi oi-share-boxed" aria-hidden="true"></span> Всички изпити
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <li class="nav-item px-3">
            <NavLink class="nav-link" href="SchoolSubjects">
                <span class="oi oi-plus" aria-hidden="true"></span> Учебни предмети
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="Contacts">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Контакти
            </NavLink>
        </li>
    </ul>
</div>

@code {
    bool collapseNavMenu = true;
    string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
