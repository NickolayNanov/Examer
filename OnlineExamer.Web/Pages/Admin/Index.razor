@page "/Admin"

@using OnlineExamer.Core.AdminService
@using OnlineExamer.Models.ViewModels.Admin

@attribute [Authorize(Roles = "Admin")]

@inject IAdminService service
@inject NavigationManager navigation

@if(Model != null)
{
    <div class="d-flex justify-content-between">
        <a class="btn btn-primary" href="Admin/Users">Потребители: (@Model.UsersCount)</a>
        <a class="btn btn-primary" href="Admin/AllExams">Изпити: (@Model.ExamsCount)</a>
    </div>
}

<AuthorizeView Roles="Admin">
    <div class="row mt-12 text-center">
        <div class="col-md-6">
            <a class="btn btn-primary" style="color: white;" href="Admin/Create">Нов тест/матура</a>
        </div>
        <div class="col-md-6">
            <a class="btn btn-primary" style="color: white;" href="Admin/CreateSubject">Добави предмет</a>
        </div>
        <div class="col-md-6">
            <a class="btn btn-primary" style="color: white;" href="Admin/UploadExam">Качи изпит</a>
        </div>
    </div>
</AuthorizeView>

@code { 
    public AdminModel Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model = await service.DataAsync();
    }
}
