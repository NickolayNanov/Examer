@page "/Admin/AllExams"

@using OnlineExamer.Core.AdminService
@using OnlineExamer.Models.ViewModels.Exams

@attribute [Authorize(Roles = "Admin")]

@inject IAdminService service

@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Предмет</th>
                <th scope="col">Година</th>
                <th scope="col">Действие</th>
            </tr>
        </thead>
        <tbody>
            
            @foreach (var exam in Model.Data)
            {
                <tr>
                    <td>@exam.Parse()</td>
                    <td>@exam.YearOfCreation</td>
                    <td>
                        <button class="btn btn-danger"
                                data-toggle="modal"
                                data-target="#removeExamModal_@(exam.ExamType)_@exam.YearOfCreation">
                            Изтрий
                        </button>

                        <div class="modal fade" id="removeExamModal_@(exam.ExamType)_@exam.YearOfCreation" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Сигурни ли сте че искате да изтриете матура @exam.ExamType, @exam.YearOfCreation?</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Затвори</button>
                                        <button type="button" class="btn btn-danger" 
                                                @onclick="() => Delete(exam.ExamType, exam.YearOfCreation)" data-dismiss="modal">Изтрий</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3>Loading...</h3>
}


@code {

    public ExamsAll Model { get; set; }

    private void Delete(string examType, int year)
    {
        if(string.IsNullOrEmpty(examType) || year < 0 || year > 2030)
        {
            return;
        }

        service.Delete(examType, year);
    }

    protected override async Task OnInitializedAsync()
    {
        Model = await service.AllExams();
    }
}
