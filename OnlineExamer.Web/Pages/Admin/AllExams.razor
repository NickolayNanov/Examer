@page "/Admin/AllExams"

@using OnlineExamer.Core.AdminService
@using OnlineExamer.Models.ViewModels.Exams

@attribute [Authorize(Roles = "Admin")]

@inject IAdminService service

@if (Model != null)
{
    <div class="row">
        <input class="col-md-8 mr-5 mb-1" type="text" placeholder="Име на предмет..." @bind="Search"/>
        <button class="btn btn-primary col-md-3" @onclick="FilterExams">Филтрирай</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th scope="col">Предмет</th>
                <th scope="col">Година</th>
                <th scope="col">Действие</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var exam in DataToShow)
            {
                <tr>
                    <td>@exam.Parse()</td>
                    <td>@exam.YearOfCreation</td>
                    <td>
                        <button class="btn btn-danger"
                                data-toggle="modal"
                                data-target="#removeExamModal_@(exam.ExamType)_@exam.YearOfCreation">
                            Изтрий
                        </button>

                        <div class="modal fade" id="removeExamModal_@(exam.ExamType)_@exam.YearOfCreation" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">Сигурни ли сте че искате да изтриете матура @exam.Parse(), @exam.YearOfCreation?</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Затвори</button>
                                        <button type="button" class="btn btn-danger"
                                                @onclick="() => Delete(exam.ExamType, exam.YearOfCreation)" data-dismiss="modal">
                                            Изтрий
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3>Loading...</h3>
}


@code {
    public ExamsAll Model { get; set; }
    private IList<ExamViewModel> DataToShow;
    private string Search = string.Empty;

    private void Delete(string examType, int year)
    {
        if (string.IsNullOrEmpty(examType) || year < 0 || year > 2030)
        {
            return;
        }

        bool isDeleted = service.Delete(examType, year);

        if (isDeleted)
        {
            ExamViewModel deleted = Model.Data.FirstOrDefault(x => x.ExamType == examType && x.YearOfCreation == year);
            DataToShow.Remove(deleted);
            Model.Data.Remove(deleted);
        }
    }

    private void FilterExams()
    {
            DataToShow = Model.Data;
            DataToShow = DataToShow.Where(x => x.Parse().ToLower().StartsWith(Search.ToLower())).ToList();
            this.StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Model = await service.AllExamsAsync();
        DataToShow = Model.Data;
    }
}
