@page "/Admin/CreateSubject"

@using OnlineExamer.Core.AdminService

@inject IAdminService service

<h3 class="text-center">Създай предвет</h3>
<h3 class="text-danger">@ErrorMsg</h3>
<h3 class="text-success">@SuccessMsg</h3>
<div>
    <div class="form-group mb-3">
        <label>Предмет</label>
        <input class="form-control" type="text" @bind="Subject" />
    </div>
    <div class="form-group">
        <button class="btn btn-primary form-group" @onclick="CreateAsync">Създай</button>
    </div>
</div>

@code {
    [Parameter] public string Subject { get; set; }
    string ErrorMsg = "";
    string SuccessMsg = "";

    protected override Task OnInitializedAsync()
    {
        ErrorMsg = "";
        SuccessMsg = "";
        return base.OnInitializedAsync();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrEmpty(Subject))
        {
            ErrorMsg = "Моля попълнете полето";
            return;
        }

        bool result = await service.CreateSubjectAsync(Subject);

        if (!result)
        {
            ErrorMsg = "Вече има такъв предмет";
            SuccessMsg = "";
        }

        SuccessMsg = $"Предмет {Subject} беше добавен успешто";
        Subject = "";
        return;

    }
}
