@page "/SchoolSubjects"

@using OnlineExamer.Core.SchoolSubjects
@using OnlineExamer.Models.ViewModels.SchoolSubjects

@inject ISchoolSubjectService service

<h1>Учебни предмети</h1>

<p>Това са най-често търсените предмети.</p>

@if (Subjects != null)
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Име</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in Subjects)
            {
                <tr>
                    <td>@(index++)</td>
                    <td>@subject.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3>Loading...</h3>
}

@code {
    private int index = 1;
    public IEnumerable<SchoolSubjectViewModel> Subjects { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Subjects = await service.GetAll();
    }
}
