@page "/AllExams/{Subject}/{Year:int}"

@attribute [Authorize]

@using OnlineExamer.Models.ViewModels.Exams
@using OnlineExamer.Core.ExamService
@using OnlineExamer.Infrastructure
@using Microsoft.JSInterop

@inject NavigationManager NavigationManager
@inject IExamService service

@if (Data != null)
{
    <h3 class="text-center">Изпит по @(ExamTypeParser.Parse<ExamQuestionsViewModel>(Data)) - @Year</h3>

    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @for (int i = 0; i < Data.Questions.Count; i++)
                {
                    <span>@(i + 1). @(Data.Questions[i].Title)</span>

                    if (!Data.Questions[i].IsOpenAnswer)
                    {
                        <ul class="list-group" id="question_@(i - 1)">
                            @for (int j = 0; j < Data.Questions[i].Answers.Count; j++)
                            {
                                <li onclick="giveAnswer(@(i - 1), @j)"
                                    style="background: @Data.Questions[i].Answers[j].BackgroundColor"
                                    class="list-group-item mb-3 marked-answer"
                                    id="question_@(i - 1)_answer_@j">
                                    <input @bind="@Data.Questions[i].Answers[j].IsSelected"
                                           type="checkbox"
                                           id="input_@(i - 1)_question_@j"
                                           class="check"
                                           style="display:none" />
                                    <label>@Data.Questions[i].Answers[j].Content</label>
                                </li>
                            }
                        </ul>
                    }
                }
                <h5 class="text-danger">@ErrorMsg</h5>

                <div class="row">
                    <div class="col-md-5"></div>
                    <a class="btn btn-primary mb-4" @onclick="Solve">
                        <span aria-hidden="true" style="color: white">Предай</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h1>Loading...</h1>
}

@code {
    [Parameter] public string Subject { get; set; }
    [Parameter] public int Year { get; set; }

    public static ExamQuestionsViewModel Data { get; set; }

    private string ErrorMsg = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Data = await service.LoadExamByExamTypeAndYearAsync(Subject, Year);
        Data.YearOfCreation = Year;
        Data.ExamType = Subject;
    }

    [JSInvokable(identifier: "SelectAnswer")]
    public static Task Select(int questionId, int answerId)
    {
        Data.Questions.Select(x => x.Answers.Select(a => a.IsSelected = false));
        Data.Questions[questionId + 1].Answers[answerId].IsSelected = true;
        return Task.CompletedTask;
    }

    private async Task Solve()
    {
        if (Data.Questions.Any(q => q.Answers.All(x => x.IsSelected == false)) || Data.Questions?.Count == 0)
        {
            ErrorMsg = "Всички въпроси трябва да имат избран отговор!";
            return;
        }
        AuthenticationState authState = await AuthenticationStateTask;
        int ExamResultId = await this.service.SolveExamAsync(Data, authState.User.Identity.Name);
        NavigationManager.NavigateTo($"ExamResults/{Subject}/{Year}/{ExamResultId}", true);
    }
}
