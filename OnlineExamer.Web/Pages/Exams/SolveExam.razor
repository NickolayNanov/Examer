@page "/AllExams/{Subject}/{Year:int}"

@attribute [Authorize]

@using OnlineExamer.Models.ViewModels.Exams
@using OnlineExamer.Core.ExamService
@using OnlineExamer.Infrastructure
@using Microsoft.JSInterop

@inject NavigationManager NavigationManager
@inject IExamService service

@if (Data != null)
{
    <h3 class="text-center">Изпит по @(ExamTypeParser.Parse<ExamQuestionsViewModel>(Data)) - @Year</h3>

    <div class="container">
        <div class="row">
            <div class="col-md-12">
                @for (int i = 0; i < Data.Questions.Count; i++)
                {
                    <span>@(Data.Questions[i].Title)</span>
                    if (Data.Questions[i].Answers.Count != 0)
                    {
                        if (!Data.Questions[i].IsOpenAnswer)
                        {
                            <ul class="list-group" id="question_@(i - 1)">
                                @for (int j = 0; j < Data.Questions[i].Answers.Count; j++)
                                {
                                    @if (Data.Questions[i].IsSingleAnswer)
                                    {
                                        <li onclick="giveAnswer(@(i - 1), @j)"
                                            style="background: @Data.Questions[i].Answers[j].BackgroundColor"
                                            class="list-group-item mb-3 marked-answer"
                                            id="question_@(i - 1)_answer_@j">
                                            <input @bind="@Data.Questions[i].Answers[j].IsSelected"
                                                   type="checkbox"
                                                   id="input_@(i - 1)_question_@j"
                                                   class="check"
                                                   style="display:none" />
                                            <label>@Data.Questions[i].Answers[j].Content</label>
                                        </li>
                                    }
                                }
                                @if (!string.IsNullOrEmpty(Data.Questions[i].ImgUrl))
                                {
                                    <img src="@Data.Questions[i].ImgUrl" width="300" height="300" />
                                }
                                <br />
                            </ul>
                        }
                        else
                        {
                            <br />
                            <br />
                            <br />
                        }
                    }
                }
                <h5 class="text-danger">@ErrorMsg</h5>

                <div class="row">
                    <div class="col-md-5"></div>
                    <a class="btn btn-primary mb-4" data-toggle="modal" data-target="#solveExam">
                        <span aria-hidden="true" style="color: white">Предай</span>
                    </a>
                </div>

                <div class="modal fade" id="solveExam" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Сигурни ли сте че искате да предадете изпита? Проверете, че сте отговорили на всеки отговор и продължете</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Затвори</button>
                                <button type="button" class="btn btn-danger"
                                        @onclick="() => Solve()" data-dismiss="modal">
                                    Продължи
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h1>Loading...</h1>
}

@code {
    [Parameter] public string Subject { get; set; }
    [Parameter] public int Year { get; set; }

    public static ExamQuestionsViewModel Data { get; set; }

    private string ErrorMsg = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Data = await service.LoadExamByExamTypeAndYearAsync(Subject, Year);
        Data.YearOfCreation = Year;
        Data.ExamType = Subject;
    }

    [JSInvokable(identifier: "SelectAnswer")]
    public static Task SelectSingleAnswer(int questionId, int answerId)
    {
        Data.Questions[questionId + 1].Answers.ToList().ForEach(x => x.IsSelected = false);
        Data.Questions[questionId + 1].Answers[answerId].IsSelected = true;
        return Task.CompletedTask;
    }

    private async Task Solve()
    {
        AuthenticationState authState = await AuthenticationStateTask;
        int ExamResultId = await this.service.SolveExamAsync(Data, authState.User.Identity.Name);
        NavigationManager.NavigateTo($"ExamResults/{Subject}/{Year}/{ExamResultId}", true);
    }
}
