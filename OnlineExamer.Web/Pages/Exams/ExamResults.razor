@page "/ExamResults/{Subject}/{Year:int}/{ExamResultId:int}"

@attribute [Authorize]

@using OnlineExamer.Core.ExamService
@using OnlineExamer.Models.ViewModels.Exams

@inject IExamService service

@if (ExamResult != null)
{
    @if (areResultsVisible)
    {
        if (ExamResultId != 0)
        {
            <h3 class="text-center">@ExamResult.Subject (@Year)</h3>
            <h3 class="text-center">
                Вие изкарахте @ExamResult.Points точки от @ExamResult.MaxPoints максимални
                @*Вашата оценка е @String.Format(CultureInfo.InvariantCulture, "{0:0.00}", ExamResult.Grade)*@
            </h3>

            <div class="row">
                @foreach (var result in ExamResult.PastResults)
                {
                    <div class="col-md-4">

                        <div class="card" style="width: 18rem; border-radius: 4px;">
                            <div class="card-body">
                                <h5 class="card-title">Година: @Year</h5>
                                <p class="card-text">Точки: @result.Points/@result.MaxPoints</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <h3>Не успяхте да подобрите резултата си.</h3>
    }
}

@code {
    [Parameter] public string Subject { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public int ExamResultId { get; set; }
    private bool areResultsVisible = true;

    ExamQuestionsViewModel questions = null;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    public ExamResult ExamResult { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        ExamResult = await this.service.GetExamResultByExamIdAndUsernameAsync(ExamResultId, authState.User.Identity.Name);
    }

    
}
