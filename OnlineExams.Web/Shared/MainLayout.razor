@inherits LayoutComponentBase

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4">
        <AuthorizeView>
            <Authorized>
                Hello, @context.User.Identity.Name!
                <button class="btn btn-primary ml-2">Logout</button>
            </Authorized>
            <NotAuthorized>
                <button>Login</button>
                <button>Register</button>
            </NotAuthorized>
            <Authorizing>
                Loading...
            </Authorizing>
        </AuthorizeView>        
    </div>

    <div class="content px-4">
        @Body
    </div>
</div>


